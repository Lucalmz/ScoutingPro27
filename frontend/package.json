{
  "name": "frontend",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:pwa": "vite build --outDir dist-pwa",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "purge:diagnostics": "node scripts/purge-diagnostics.mjs",
    "test:e2e": "node e2e/multi-client.e2e.js && cross-env SKIP_BUILD=1 node e2e/qr-mobile-join.e2e.js && cross-env SKIP_BUILD=1 node e2e/inbox-lifecycle.e2e.js && cross-env SKIP_BUILD=1 node e2e/comprehensive-interactive.e2e.js && cross-env SKIP_BUILD=1 node e2e/webrtc-resilience.e2e.js",
    "test:e2e:multi": "node e2e/multi-client.e2e.js",
    "test:e2e:ui": "cross-env SHOW_UI=1 node e2e/multi-client.e2e.js",
    "test:e2e:inbox": "node e2e/inbox-lifecycle.e2e.js",
    "test:e2e:qr": "node e2e/qr-mobile-join.e2e.js",
    "test:e2e:interactive": "node e2e/comprehensive-interactive.e2e.js",
    "test:e2e:resilience": "node e2e/webrtc-resilience.e2e.js",
    "capture:userguide": "node generators/capture-userguide-screens.js",
    "export:userguide-pdf": "node generators/export-userguide-pdf.js"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "markdown-it": "^15.0.0",
    "mqtt": "^5.15.2",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "tinybase": "^10.1.0",
    "vue": "^3.5.40",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@tsconfig/node24": "^24.0.4",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^15.11.7",
    "npm-run-all2": "^9.0.2",
    "puppeteer": "^25.5.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
